# Autonom-OS runtime configuration.
# Copy to ops/autonomos.env (which is gitignored) and edit.
# Every name here is the one KD-7 gives it: a provider swap is a config change.

APP_TZ=America/Bogota
APP_VERSION=0.1.0

# --- storage ----------------------------------------------------------------
# Relative paths resolve against the repository root.
DB_PATH=data/autonomos.db
SNAPSHOT_DIR=data/snapshots
SNAPSHOT_KEEP_DAYS=7

# --- listeners --------------------------------------------------------------
AUTONOMOS_API_HOST=127.0.0.1
# The loopback port `tailscale serve` forwards to. It is 8001 and NOT the
# conventional 8000: on this host 8000 is permanently held by an unrelated
# project's Docker container (`trace_erp_api`, published on all interfaces).
# Change this if 8001 is ever taken too — ops/setup.sh --check tells you.
AUTONOMOS_API_PORT=8001

# The tailnet origin, echoed by GET /api/health so the phone can learn the other
# origin WHILE the server is reachable — it is used when the server is not, and
# at that moment nothing would answer a fetch. Set it after `tailscale serve` is
# running; `tailscale status` shows the name. Never inferred from a request.
PUBLIC_URL=
# The LAN fallback origin for 15.5 (home internet down, both devices on the
# private network). Set it to THIS PC's DHCP-reserved LAN address — one named
# interface, never 0.0.0.0. It is unauthenticated by A6's deliberate choice, so
# the home LAN is its access boundary: LEAVE IT UNSET on any network you do not
# control, and the fallback simply does not start.
LAN_BIND_ADDR=
LAN_PORT=8443
TLS_CERTFILE=ops/certs/lan-cert.pem
TLS_KEYFILE=ops/certs/lan-key.pem

# --- static SPA -------------------------------------------------------------
FRONTEND_DIST=frontend/dist

# --- LLM (KD-6, KD-7) -------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
# The answer budget is a DEADLINE from the job's created_at, not a duration:
# time spent queueing behind a transcription is subtracted from it (KD-11).
LLM_DEADLINE_ANSWER_S=110
LLM_MIN_START_BUDGET_S=30
# The summary has no deadline in the spec; a tight value only manufactured
# permanently `failed` rows (KD-6).
LLM_TIMEOUT_SUMMARY_S=300
LLM_MAX_TOKENS_ANSWER=220
LLM_MAX_TOKENS_SUMMARY=320
# Load-bearing, not a round number: at 26 tok/s of prompt evaluation, raising
# this is the fastest way to break 11.12 (KD-6, KD-10).
JOURNAL_CONTEXT_TOKENS=1200

# --- transcription (KD-5, KD-7) ---------------------------------------------
STT_PROVIDER=whispercpp_http
STT_BASE_URL=http://127.0.0.1:8081
STT_MODEL=small
STT_LANGUAGE=es
STT_TIMEOUT_S=20
MAX_AUDIO_S=32
MAX_AUDIO_BYTES=2097152

# --- category assist (KD-8 layer 2) -----------------------------------------
ASSIST_TIMEOUT_S=6
ASSIST_MAX_TOKENS=8

# --- arbiter and scheduler (KD-12) ------------------------------------------
ARBITER_QUIET_PERIOD_S=60
ARBITER_PREEMPT_GRACE_S=2
SCHEDULER_TICK_S=900
SCHEDULER_ENABLED=1
SUMMARY_MAX_ATTEMPTS=3

LOG_LEVEL=INFO
